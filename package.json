{
  "name": "youhired",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Find remote jobs you're eligible for and fill in applications with your own AI key.",
  "scripts": {
    "start": "tsx server/index.ts",
    "dev": "tsx watch --ignore web server/index.ts",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo": "tsx scripts/demo-greenhouse.ts",
    "postinstall": "playwright install chromium || echo \"(Using your installed Google Chrome instead of Playwright Chromium)\"",
    "build:extension": "node scripts/build-extension.mjs",
    "build:demo": "vite build --mode demo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@google/genai": "^2.31.0",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^1.62.0",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "openai": "^7.45.1",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "unpdf": "^1.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5",
    "@types/multer": "^2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "tsx": "^4",
    "typescript": "^5",
    "vite": "^7",
    "vitest": "^3"
  }
}
